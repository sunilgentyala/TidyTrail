default_platform(:ios)

platform :ios do
  desc "Build the app and run the XCTest suite on an iOS Simulator"
  lane :test do
    run_tests(
      scheme: "TidyTrail",
      devices: ["iPhone 15"]
    )
  end

  desc "Build a signed archive and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key
    )

    latest_build = latest_testflight_build_number(api_key: api_key)
    increment_build_number(build_number: latest_build + 1)

    build_app(
      scheme: "TidyTrail",
      export_method: "app-store"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
